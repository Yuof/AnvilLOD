// Version information for PenguLOD.dll, filled in by CMake from VERSION. It is what Windows shows under
// Properties > Details, and what virus scanners read to tell what a DLL is and who made it.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS @PENGULOD_RC_FILEFLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PenguLOD contributors"
            VALUE "FileDescription", "PenguLOD SKSE plugin for @PENGULOD_RUNTIME_NAME@"
            VALUE "FileVersion", "@PENGULOD_VERSION@"
            VALUE "InternalName", "PenguLOD"
            VALUE "LegalCopyright", "Copyright (c) 2026 opteron-x86 and PenguLOD contributors. GPL-3.0-only."
            VALUE "OriginalFilename", "PenguLOD.dll"
            VALUE "ProductName", "PenguLOD"
            VALUE "ProductVersion", "@PENGULOD_VERSION@"
            VALUE "Comments", "Source: https://github.com/opteron-x86/PenguLOD"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
